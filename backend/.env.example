# === Backend FantaFormula1 (Render) ===
# Supabase → Dashboard → Project Settings → API
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Service role key: SOLO backend, mai committare, mai incollare in chat
SUPABASE_SERVICE_ROLE_KEY=__service_role_key__
# Segreto per firmare i JWT di sessione. Genera con:  openssl rand -base64 32
JWT_SECRET=__stringa_lunga_casuale__
# URL pubblico del frontend su Vercel (per CORS)
FRONTEND_ORIGIN=https://fantaformulauno.vercel.app
# Abilita il cookie di sessione "Secure" in produzione (Render). PORT lo imposta Render.
NODE_ENV=production
